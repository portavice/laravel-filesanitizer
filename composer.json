{
  "name": "portavice/laravel-filesanitizer",
  "description": "Laravel integration for sytxlabs/filesanitizer",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/validation": "^10.0|^11.0|^12.0",
    "sytxlabs/filesanitizer": "*"
  },
  "require-dev": {
    "portavice/laravel-pint-config": "^2.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "Portavice\\LaravelFileSanitizer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Portavice\\LaravelFileSanitizer\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Portavice\\LaravelFileSanitizer\\FileSanitizerServiceProvider"
      ],
      "aliases": {
        "FileSanitizer": "Portavice\\LaravelFileSanitizer\\Facades\\FileSanitizer"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "cs": "pint --config vendor/portavice/laravel-pint-config/pint.json --test",
    "csfix": "pint --config vendor/portavice/laravel-pint-config/pint.json",
    "test": "vendor/bin/phpunit"
  }
}
